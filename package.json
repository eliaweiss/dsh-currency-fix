{
  "name": "dsh-currency-fix",
  "version": "0.1.0",
  "private": true,
  "description": "Stops prices like $150 in chat replies from being drawn as LaTeX math in the DeepSeek Harness Web UI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliaweiss/dsh-currency-fix.git"
  },
  "homepage": "https://github.com/eliaweiss/dsh-currency-fix#readme",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
